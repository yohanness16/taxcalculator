---
import Layout from '../../layouts/Layout.astro';
import { GLOBAL_COUNTRIES_DATA } from '../../data/globalTaxData';

const countries = GLOBAL_COUNTRIES_DATA;
---

<Layout
  title="Global Tax Brackets & Statutory Tax Law Guides 2026 | GlobalTaxCalc"
  description="Comprehensive statutory tax bracket guides, marginal tax rates, standard deductions, and social security legislation across all global jurisdictions."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tax Brackets', url: '/tax-brackets' },
  ]}
>
  <section class="py-12 px-4 max-w-7xl mx-auto text-center space-y-3">
    <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
      Global Tax Brackets & <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-teal-600">Statutory Tax Law Guides</span>
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
      Explore official progressive marginal tax rates, personal tax allowances, and mandatory social security contributions for each country.
    </p>
  </section>

  <section class="max-w-7xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {countries.map((c) => (
        <a
          href={`/tax-brackets/${c.countryCode.toLowerCase()}`}
          class="group p-6 bg-white dark:bg-[#151D2A] border border-slate-200 dark:border-slate-800 rounded-3xl shadow-sm hover:shadow-lg hover:border-emerald-500 transition space-y-4 flex flex-col justify-between"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="text-2xl">{c.flagEmoji}</span>
                <h3 class="font-extrabold text-base text-slate-900 dark:text-white group-hover:text-emerald-600 transition-colors">
                  {c.countryName}
                </h3>
              </div>
              <span class="text-xs font-bold px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-lg">
                {c.taxSystem}
              </span>
            </div>

            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed">
              {c.summaryDescription}
            </p>

            <div class="text-[11px] text-slate-400 pt-1">
              Legislation: <strong class="text-slate-600 dark:text-slate-300">{c.statutoryLegislation}</strong>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-semibold">{c.brackets.length} Tax Brackets</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">View Tax Guide →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
