---
import Layout from '../../layouts/Layout.astro';
import { GLOBAL_COUNTRIES_DATA } from '../../data/globalTaxData';
import { GLOBAL_TAX_FAQS } from '../../data/faqData';
import AdUnit from '../../components/AdUnit';

export async function getStaticPaths() {
  return GLOBAL_COUNTRIES_DATA.map((c) => ({
    params: { country: c.countryCode.toLowerCase() },
    props: { countryData: c },
  }));
}

const { countryData } = Astro.props;
const faqs = GLOBAL_TAX_FAQS[countryData.countryCode] || [
  {
    question: `What are the income tax brackets in ${countryData.countryName}?`,
    answer: `${countryData.countryName} operates a ${countryData.taxSystem.toLowerCase()} tax system administered by ${countryData.taxAuthorityName} under ${countryData.statutoryLegislation}.`,
  },
  {
    question: `What social security or pension contributions apply in ${countryData.countryName}?`,
    answer: `Mandatory contributions include: ${countryData.socialContributions.map(s => `${s.name} (${(s.employeeRate * 100).toFixed(1)}%)`).join(', ') || 'None'}.`,
  },
];

const pageTitle = `${countryData.countryName} Tax Brackets & Rates 2026 - Official Guide | GlobalTaxCalc`;
const pageDescription = `Detailed 2026 individual income tax brackets, marginal rates, standard deductions, and social security pension rules for ${countryData.countryName} (${countryData.currencyCode}).`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Tax Brackets', url: '/tax-brackets' },
    { name: countryData.countryName, url: `/tax-brackets/${countryData.countryCode.toLowerCase()}` },
  ]}
>
  <section class="py-10 md:py-12 px-4 max-w-5xl mx-auto space-y-8">
    {/* Breadcrumbs & Header */}
    <div class="text-center space-y-3">
      <div class="inline-flex items-center space-x-2 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800/80 px-3.5 py-1 rounded-full text-xs font-bold text-emerald-700 dark:text-emerald-300">
        <span class="text-base">{countryData.flagEmoji}</span>
        <span>{countryData.countryName} Statutory Tax Guide</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
        {countryData.countryName} <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-teal-600">Tax Brackets & Rates (2026)</span>
      </h1>

      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Comprehensive statutory tax rates, withholding thresholds, social contributions, and deduction rules governed by {countryData.taxAuthorityName}.
      </p>

      <div class="pt-2">
        <a
          href={`/salary-calculator/${countryData.countryCode.toLowerCase()}`}
          class="inline-flex items-center space-x-2 py-2.5 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition shadow-md"
        >
          <span>⚡ Launch {countryData.countryName} Salary Calculator</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <AdUnit client:load slotType="leaderboard" />

    {/* Section 1: Overview & Legislation */}
    <div class="bg-white dark:bg-[#151D2A] p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4 text-xs sm:text-sm">
      <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center space-x-2">
        <span>📜</span>
        <span>Statutory Authority & Legal Framework</span>
      </h2>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
        In {countryData.countryName}, personal income taxation is administered by the <strong>{countryData.taxAuthorityName}</strong> under the authority of <strong>{countryData.statutoryLegislation}</strong>.
      </p>
      <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
        {countryData.summaryDescription}
      </p>
    </div>

    {/* Section 2: Marginal Tax Brackets Table */}
    <div class="bg-white dark:bg-[#151D2A] p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center space-x-2">
          <span>📊</span>
          <span>2026 Progressive Marginal Tax Brackets</span>
        </h2>
        <span class="text-xs font-bold text-slate-400">Currency: {countryData.currencyCode}</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-400 font-bold uppercase tracking-wider text-xs">
              <th class="py-3">Income Bracket ({countryData.currencySymbol})</th>
              <th class="py-3 text-right">Marginal Tax Rate</th>
              <th class="py-3 text-right">Bracket Type</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-medium">
            {countryData.brackets.map((b, idx) => (
              <tr>
                <td class="py-3 font-bold text-slate-800 dark:text-slate-200">
                  {b.description || `${countryData.currencySymbol} ${b.thresholdMin.toLocaleString()} – ${b.thresholdMax === Infinity ? 'Above' : b.thresholdMax.toLocaleString()}`}
                </td>
                <td class="py-3 text-right font-extrabold text-rose-500">
                  {(b.marginalRate * 100).toFixed(1)}%
                </td>
                <td class="py-3 text-right text-slate-500 dark:text-slate-400 text-xs">
                  {idx === 0 && b.marginalRate === 0 ? 'Tax-Free Allowance' : `Tier ${idx + 1}`}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    {/* Section 3: Social Security & Pension Contributions */}
    {countryData.socialContributions.length > 0 && (
      <div class="bg-white dark:bg-[#151D2A] p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 flex items-center space-x-2">
          <span>🛡️</span>
          <span>Mandatory Social Security & Pension Contributions</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          {countryData.socialContributions.map((sc) => (
            <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200/60 dark:border-slate-800 space-y-2">
              <h3 class="font-bold text-sm text-slate-900 dark:text-slate-100">{sc.name}</h3>
              <div class="text-xs space-y-1 text-slate-600 dark:text-slate-400">
                <div class="flex justify-between">
                  <span>Employee Share:</span>
                  <strong class="text-amber-600 dark:text-amber-400">{(sc.employeeRate * 100).toFixed(1)}%</strong>
                </div>
                <div class="flex justify-between">
                  <span>Employer Share:</span>
                  <strong class="text-slate-700 dark:text-slate-300">{(sc.employerRate * 100).toFixed(1)}%</strong>
                </div>
                {sc.cappedEarningsLimit && (
                  <div class="flex justify-between text-[11px] text-slate-400 pt-1 border-t border-slate-200 dark:border-slate-700">
                    <span>Wage Cap:</span>
                    <span>{countryData.currencySymbol} {sc.cappedEarningsLimit.toLocaleString()}</span>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Section 4: Country FAQs */}
    <div class="bg-white dark:bg-[#151D2A] p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
      <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">
        Frequently Asked Questions: {countryData.countryName} Taxation
      </h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-200/60 dark:border-slate-800">
            <summary class="font-bold text-xs sm:text-sm text-slate-900 dark:text-slate-100 cursor-pointer flex justify-between items-center list-none">
              <span>{faq.question}</span>
              <span class="text-emerald-500 group-open:rotate-180 transition-transform">↓</span>
            </summary>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mt-2 pt-2 border-t border-slate-200 dark:border-slate-700">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
