---
import Layout from '../../layouts/Layout.astro';
import GlobalTaxCalculatorApp from '../../components/GlobalTaxCalculatorApp';
import { GLOBAL_COUNTRIES_DATA, getCountryTaxModel } from '../../data/globalTaxData';
import { GLOBAL_TAX_FAQS } from '../../data/faqData';

export async function getStaticPaths() {
  return GLOBAL_COUNTRIES_DATA.map((c) => ({
    params: { country: c.countryCode.toLowerCase() },
    props: { countryData: c },
  }));
}

const { countryData } = Astro.props;
const faqs = GLOBAL_TAX_FAQS[countryData.countryCode] || [
  {
    question: `How is employment income tax calculated in ${countryData.countryName}?`,
    answer: `${countryData.summaryDescription} The primary tax authority is ${countryData.taxAuthorityName}.`,
  },
  {
    question: `What are the statutory deductions in ${countryData.countryName}?`,
    answer: `Statutory deductions include income tax and social contributions (${countryData.socialContributions.map(s => `${s.name}: ${(s.employeeRate * 100).toFixed(1)}%`).join(', ') || 'none'}).`,
  },
];

const pageTitle = `${countryData.countryName} Salary Calculator 2026 - Net Take-Home & Income Tax | GlobalTaxCalc`;
const pageDescription = `Calculate your 2026 net take-home salary, income taxes, and pension deductions in ${countryData.countryName} (${countryData.currencyCode}). Based on ${countryData.statutoryLegislation}.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  faqs={faqs}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Salary Calculators', url: '/salary-calculator' },
    { name: countryData.countryName, url: `/salary-calculator/${countryData.countryCode.toLowerCase()}` },
  ]}
>
  {/* Country Hero Header */}
  <section class="py-10 md:py-12 px-4 max-w-7xl mx-auto text-center space-y-3">
    <div class="inline-flex items-center space-x-2 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800/80 px-3.5 py-1 rounded-full text-xs font-bold text-emerald-700 dark:text-emerald-300">
      <span class="text-base">{countryData.flagEmoji}</span>
      <span>{countryData.countryName} Statutory Tax System</span>
      <span>•</span>
      <span>{countryData.currencyCode}</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white max-w-3xl mx-auto">
      {countryData.countryName} <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-teal-600">Salary & Take-Home Calculator</span>
    </h1>

    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
      {countryData.summaryDescription}
    </p>
  </section>

  {/* Interactive Calculator App preloaded with this country */}
  <section class="max-w-7xl mx-auto px-4 pb-14">
    <GlobalTaxCalculatorApp
      client:load
      initialCountryCode={countryData.countryCode}
      initialSalary={countryData.defaultSalaryAnnual}
    />
  </section>

  {/* Statutory Legal & Tax Details */}
  <section class="max-w-7xl mx-auto px-4 py-10 border-t border-slate-200 dark:border-slate-800 space-y-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-xs sm:text-sm">
      
      {/* Statutory Rules Card */}
      <div class="bg-white dark:bg-[#151D2A] p-6 rounded-3xl border border-slate-200 dark:border-slate-800 space-y-4 shadow-sm">
        <h3 class="font-bold text-base text-slate-900 dark:text-slate-100 flex items-center space-x-2">
          <span>⚖️</span>
          <span>{countryData.countryName} Legal Framework</span>
        </h3>
        <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
          Administered by <strong>{countryData.taxAuthorityName}</strong> under <strong>{countryData.statutoryLegislation}</strong>.
        </p>

        {countryData.allowancesAndExemptions && (
          <div class="space-y-2 pt-2">
            <span class="font-bold text-slate-700 dark:text-slate-300 block">Key Deductions & Exemptions:</span>
            <ul class="space-y-1.5 list-disc pl-4 text-slate-600 dark:text-slate-400 text-xs">
              {countryData.allowancesAndExemptions.map((rule) => (
                <li>{rule}</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {/* Tax Brackets Summary Table */}
      <div class="bg-white dark:bg-[#151D2A] p-6 rounded-3xl border border-slate-200 dark:border-slate-800 space-y-4 shadow-sm">
        <h3 class="font-bold text-base text-slate-900 dark:text-slate-100 flex items-center space-x-2">
          <span>📊</span>
          <span>Official Marginal Tax Brackets</span>
        </h3>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-400 font-bold uppercase">
                <th class="pb-2">Taxable Range ({countryData.currencyCode})</th>
                <th class="pb-2 text-right">Marginal Rate</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-medium">
              {countryData.brackets.map((b) => (
                <tr>
                  <td class="py-2 text-slate-800 dark:text-slate-200">
                    {b.description || `${countryData.currencySymbol} ${b.thresholdMin.toLocaleString()} – ${b.thresholdMax === Infinity ? 'Above' : b.thresholdMax.toLocaleString()}`}
                  </td>
                  <td class="py-2 text-right font-bold text-rose-500">
                    {(b.marginalRate * 100).toFixed(1)}%
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>

  {/* Country Specific FAQ Section */}
  <section class="max-w-4xl mx-auto px-4 py-12 border-t border-slate-200 dark:border-slate-800 space-y-6">
    <div class="text-center space-y-1">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white">
        Frequently Asked Questions about {countryData.countryName} Taxes
      </h2>
      <p class="text-xs text-slate-400">
        Statutory answers regarding PAYE, payroll withholding, and social security.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group bg-white dark:bg-[#151D2A] border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-sm">
          <summary class="font-bold text-sm text-slate-900 dark:text-slate-100 cursor-pointer flex justify-between items-center list-none">
            <span>{faq.question}</span>
            <span class="text-emerald-500 group-open:rotate-180 transition-transform">↓</span>
          </summary>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mt-3 pt-3 border-t border-slate-100 dark:border-slate-800">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</Layout>
