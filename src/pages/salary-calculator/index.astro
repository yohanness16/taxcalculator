---
import Layout from '../../layouts/Layout.astro';
import AdSenseAd from '../../components/AdSenseAd.astro';
import AdSenseFeedAd from '../../components/AdSenseFeedAd.astro';
import { GLOBAL_COUNTRIES_DATA } from '../../data/globalTaxData';

// Alphabetically sorted master country list
const allAlphabeticalCountries = [...GLOBAL_COUNTRIES_DATA].sort((a, b) =>
  a.countryName.localeCompare(b.countryName)
);

// Group countries by region, sorted alphabetically within each region
const regions = ['Africa', 'Americas', 'Asia & Middle East', 'Europe', 'Oceania'] as const;

const countriesByRegion = regions.map((region) => ({
  region,
  countries: GLOBAL_COUNTRIES_DATA
    .filter((c) => c.region === region)
    .sort((a, b) => a.countryName.localeCompare(b.countryName)),
}));
---

<Layout
  title="All Countries Salary & Tax Calculators 2026 Directory (A–Z) | TOOLBOXS"
  description="Browse multi-country salary and income tax calculators across Africa, Europe, Americas, Asia-Pacific, and Oceania in alphabetical order. Instant take-home pay estimations with zero server tracking."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Salary Calculators', url: '/salary-calculator' },
  ]}
>
  <section class="py-12 md:py-16 px-4 max-w-7xl mx-auto text-center space-y-4">
    <div class="inline-flex items-center space-x-2 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/80 dark:border-emerald-800/80 px-4 py-1.5 rounded-full text-xs font-extrabold text-emerald-700 dark:text-emerald-300 shadow-xs">
      <span>🌍 100+ Jurisdictions</span>
      <span class="text-slate-300 dark:text-slate-600">•</span>
      <span>2026 Statutory Matrices</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
      Global Salary & Tax <span class="text-emerald-600 dark:text-emerald-400">Jurisdiction Directory (A–Z)</span>
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
      Select a country below in alphabetical order to launch the dedicated payroll and income tax calculator preconfigured with statutory brackets, currency codes, and social security rules.
    </p>

    <AdSenseAd />
  </section>

  <section class="max-w-7xl mx-auto px-4 pb-20 space-y-14">
    {countriesByRegion.map(({ region, countries }, index) => (
      <div class="space-y-5">
        <h2 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white border-b border-slate-200/80 dark:border-slate-800/80 pb-3 flex items-center justify-between">
          <span class="flex items-center space-x-2">
            <span>{region}</span>
          </span>
          <span class="text-xs font-bold px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-full border border-slate-200/60 dark:border-slate-700/60">
            {countries.length} Countries
          </span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {countries.map((c) => (
            <a
              href={`/salary-calculator/${c.countryCode.toLowerCase()}`}
              class="group p-6 bg-white dark:bg-[#0F172A] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl shadow-card-light dark:shadow-none hover:shadow-card-hover hover:border-emerald-500/80 transition-all space-y-3 flex flex-col justify-between hover:-translate-y-0.5"
            >
              <div class="space-y-2">
                <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-2.5">
                    <span class="text-2xl">{c.flagEmoji}</span>
                    <span class="font-extrabold text-base text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                      {c.countryName}
                    </span>
                  </div>
                  <span class="text-[11px] font-mono font-bold px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-lg border border-slate-200/60 dark:border-slate-700/60">
                    {c.currencyCode}
                  </span>
                </div>

                <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed">
                  {c.summaryDescription}
                </p>
              </div>

              <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold">
                <span class="text-slate-400 font-medium text-[11px]">{c.taxSystem}</span>
                <span class="font-bold text-emerald-600 dark:text-emerald-400 group-hover:translate-x-0.5 transition-transform">Calculate Paycheck →</span>
              </div>
            </a>
          ))}
        </div>
        {index === 1 && (
          <div class="pt-4">
            <AdSenseFeedAd />
          </div>
        )}
      </div>
    ))}
  </section>
</Layout>
