---
import Layout from '../../../layouts/Layout.astro';
import GlobalTaxCalculatorApp from '../../../components/GlobalTaxCalculatorApp';
import AdUnit from '../../../components/AdUnit';
import AffiliateCard from '../../../components/AffiliateCard';
import { GLOBAL_COUNTRIES_DATA, getCountryTaxModel } from '../../../data/globalTaxData';
import { calculateGlobalSalary } from '../../../engines/internationalTaxEngine';

export async function getStaticPaths() {
  const paths: any[] = [];

  for (const country of GLOBAL_COUNTRIES_DATA) {
    const amounts = country.popularSalaryAmounts && country.popularSalaryAmounts.length > 0
      ? country.popularSalaryAmounts
      : [
          Math.round(country.defaultSalaryAnnual * 0.5),
          Math.round(country.defaultSalaryAnnual * 0.75),
          country.defaultSalaryAnnual,
          Math.round(country.defaultSalaryAnnual * 1.25),
          Math.round(country.defaultSalaryAnnual * 1.5),
          Math.round(country.defaultSalaryAnnual * 2.0),
        ];

    // Deduplicate and sort amounts
    const sortedAmounts = Array.from(new Set(amounts)).sort((a, b) => a - b);

    sortedAmounts.forEach((amt, idx) => {
      const prevAmt = idx > 0 ? sortedAmounts[idx - 1] : null;
      const nextAmt = idx < sortedAmounts.length - 1 ? sortedAmounts[idx + 1] : null;

      paths.push({
        params: {
          country: country.countryCode.toLowerCase(),
          milestone: `${amt}-${country.currencyCode.toLowerCase()}`,
        },
        props: {
          countryData: country,
          salaryAmount: amt,
          prevMilestone: prevAmt ? `${prevAmt}-${country.currencyCode.toLowerCase()}` : null,
          prevAmount: prevAmt,
          nextMilestone: nextAmt ? `${nextAmt}-${country.currencyCode.toLowerCase()}` : null,
          nextAmount: nextAmt,
          allMilestones: sortedAmounts,
        },
      });
    });
  }

  return paths;
}

const {
  countryData,
  salaryAmount,
  prevMilestone,
  prevAmount,
  nextMilestone,
  nextAmount,
  allMilestones,
} = Astro.props;

// Pre-compute pure static SSG calculation at build time
const calcResult = calculateGlobalSalary(salaryAmount, countryData, 'ANNUAL');
const curr = countryData.currencySymbol || countryData.currencyCode;
const formattedGross = `${curr} ${salaryAmount.toLocaleString()}`;
const formattedNetAnnual = `${curr} ${Math.round(calcResult.netTakeHomeAnnual).toLocaleString()}`;
const formattedNetMonthly = `${curr} ${Math.round(calcResult.netTakeHomeMonthly).toLocaleString()}`;
const formattedTaxAnnual = `${curr} ${Math.round(calcResult.incomeTaxAnnual).toLocaleString()}`;
const formattedSocialAnnual = `${curr} ${Math.round(calcResult.socialSecurityOrPensionAnnual).toLocaleString()}`;

const pageTitle = `${formattedGross} Salary After Tax in ${countryData.countryName} (2026 Take-Home Pay) | TOOLBOXS`;
const pageDescription = `On a ${formattedGross} gross annual salary in ${countryData.countryName}, net take-home pay is ${formattedNetAnnual} (${formattedNetMonthly}/month). Assessed ${formattedTaxAnnual} in income tax (${calcResult.effectiveTaxRatePct}% effective rate) and ${formattedSocialAnnual} in statutory social contributions.`;

const canonicalUrl = `https://toolboxs.tech/salary-calculator/${countryData.countryCode.toLowerCase()}/${salaryAmount}-${countryData.currencyCode.toLowerCase()}`;

// Contextual dynamic FAQs pre-computed for this exact salary milestone
const dynamicFaqs = [
  {
    question: `What is the net take-home pay on a ${formattedGross} salary in ${countryData.countryName}?`,
    answer: `On a ${formattedGross} gross annual salary in ${countryData.countryName}, an individual retains an estimated ${formattedNetAnnual} per year (${formattedNetMonthly} per month, or ${curr} ${Math.round(calcResult.netTakeHomeWeekly).toLocaleString()} per week) after deducting ${formattedTaxAnnual} in income taxes and ${formattedSocialAnnual} in statutory social insurance.`,
  },
  {
    question: `What is the effective tax rate on ${formattedGross} in ${countryData.countryName}?`,
    answer: `The effective personal income tax rate on ${formattedGross} is ${calcResult.effectiveTaxRatePct}%, with a total statutory deduction rate (including pension/social security) of ${calcResult.totalDeductionRatePct}%. This results in a net keep ratio of ${calcResult.netKeepRatioPct}%.`,
  },
  {
    question: `How much does an employer spend in total to pay a ${formattedGross} salary in ${countryData.countryName}?`,
    answer: `Due to mandatory employer statutory contributions and social security levies, the total cost of employment to the employer for a ${formattedGross} gross basic salary is estimated at ${curr} ${Math.round(calcResult.employerTotalCostAnnual).toLocaleString()} annually (${curr} ${Math.round(calcResult.employerTotalCostMonthly).toLocaleString()} per month).`,
  },
  {
    question: `What legislation governs taxes on ${formattedGross} in ${countryData.countryName}?`,
    answer: `Employment compensation and payroll withholdings in ${countryData.countryName} are administered by ${countryData.taxAuthorityName} pursuant to ${countryData.statutoryLegislation}.`,
  },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Salary Calculators', url: '/salary-calculator' },
  { name: countryData.countryName, url: `/salary-calculator/${countryData.countryCode.toLowerCase()}` },
  { name: `${formattedGross} Salary Tax`, url: canonicalUrl },
];

const hreflangs = [
  { lang: `en-${countryData.countryCode.toUpperCase()}`, url: canonicalUrl },
  { lang: 'en', url: canonicalUrl },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  faqs={dynamicFaqs}
  breadcrumbs={breadcrumbs}
  hreflangs={hreflangs}
>
  {/* Top Hero Breadcrumb & Milestone Title */}
  <section class="py-8 px-4 max-w-7xl mx-auto space-y-4">
    <nav class="flex items-center space-x-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-emerald-600 transition">Home</a>
      <span>/</span>
      <a href="/salary-calculator" class="hover:text-emerald-600 transition">Calculators</a>
      <span>/</span>
      <a href={`/salary-calculator/${countryData.countryCode.toLowerCase()}`} class="hover:text-emerald-600 transition flex items-center space-x-1">
        <span>{countryData.flagEmoji}</span>
        <span>{countryData.countryName}</span>
      </a>
      <span>/</span>
      <span class="text-emerald-600 dark:text-emerald-400 font-bold font-mono">{formattedGross}</span>
    </nav>

    <div class="space-y-3">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/80 dark:border-emerald-800/80 rounded-full text-xs font-extrabold text-emerald-700 dark:text-emerald-300 shadow-xs">
        <span>📍 {countryData.countryName} ({countryData.currencyCode})</span>
        <span class="text-slate-300 dark:text-slate-600">•</span>
        <span>2026 Statutory Payroll Table</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
        <span class="text-emerald-600 dark:text-emerald-400 font-mono">{formattedGross}</span> Salary Take-Home Pay & Tax Breakdown
      </h1>

      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-3xl leading-relaxed">
        Comprehensive static financial statement and pre-computed paycheck schedules for a gross basic annual compensation of <strong class="text-slate-800 dark:text-slate-200 font-mono">{formattedGross}</strong> in {countryData.countryName}. Governed under <em>{countryData.statutoryLegislation}</em>.
      </p>
    </div>
  </section>

  {/* Pre-Computed Static Hero Summary Cards */}
  <section class="max-w-7xl mx-auto px-4 pb-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      
      <div class="p-6 bg-white dark:bg-[#0F172A] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl shadow-card-light dark:shadow-none space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Gross Annual Salary</span>
        <div class="text-xl sm:text-2xl font-black font-mono text-slate-900 dark:text-white" data-financial-figure>
          {formattedGross}
        </div>
        <p class="text-[10px] text-slate-400">100% Pre-tax baseline</p>
      </div>

      <div class="p-6 bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-3xl shadow-lg shadow-emerald-600/15 space-y-1">
        <span class="text-[10px] font-bold text-emerald-200 uppercase tracking-wider block">Net Monthly Take-Home</span>
        <div class="text-xl sm:text-2xl font-black font-mono" data-financial-figure>
          {formattedNetMonthly}
        </div>
        <p class="text-[10px] text-emerald-100">{formattedNetAnnual} / year</p>
      </div>

      <div class="p-6 bg-white dark:bg-[#0F172A] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl shadow-card-light dark:shadow-none space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Income Tax Assessed</span>
        <div class="text-xl sm:text-2xl font-black font-mono text-rose-500" data-financial-figure>
          - {formattedTaxAnnual}
        </div>
        <p class="text-[10px] text-slate-400 font-mono">{calcResult.effectiveTaxRatePct}% Effective Rate</p>
      </div>

      <div class="p-6 bg-white dark:bg-[#0F172A] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl shadow-card-light dark:shadow-none space-y-1">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Net Keep Ratio</span>
        <div class="text-xl sm:text-2xl font-black font-mono text-emerald-600 dark:text-emerald-400" data-financial-figure>
          {calcResult.netKeepRatioPct}%
        </div>
        <p class="text-[10px] text-slate-400">Retained after all statutory levies</p>
      </div>

    </div>
  </section>

  {/* Main Calculator React Interactive Island Pre-Loaded with this Salary */}
  <section class="max-w-7xl mx-auto px-4 pb-12">
    <div class="space-y-4">
      <div class="flex items-center justify-between pb-2 border-b border-slate-200/80 dark:border-slate-800/80">
        <h2 class="text-base sm:text-lg font-extrabold text-slate-900 dark:text-white">
          Interactive Scenario Simulator & Payslip Generator
        </h2>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 font-mono">
          Pre-initialized: {formattedGross}
        </span>
      </div>

      <GlobalTaxCalculatorApp
        client:load
        initialCountryCode={countryData.countryCode}
        initialSalary={salaryAmount}
      />
    </div>
  </section>

  {/* Static Multi-Frequency Pre-Computed Schedule Table */}
  <section class="max-w-7xl mx-auto px-4 py-8 space-y-6">
    <div class="space-y-1">
      <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">
        Official Pre-Computed Paycheck Conversion Schedule
      </h2>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Exact breakdown of earnings and statutory withholdings for {formattedGross} across standard pay intervals.
      </p>
    </div>

    <div class="overflow-x-auto bg-white dark:bg-[#0F172A] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl shadow-card-light dark:shadow-none p-6 sm:p-7">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-400 font-bold uppercase tracking-wider text-[10px]">
            <th class="pb-3">Frequency</th>
            <th class="pb-3">Gross Earnings</th>
            <th class="pb-3">Income Tax</th>
            <th class="pb-3">Pension / Social</th>
            <th class="pb-3 text-right">Net Take-Home</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 font-mono" data-financial-figure>
          <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors">
            <td class="py-3 font-sans font-bold text-slate-800 dark:text-slate-200">Annual (Yearly)</td>
            <td class="py-3 text-slate-700 dark:text-slate-300">{formattedGross}</td>
            <td class="py-3 text-rose-500 font-semibold">- {formattedTaxAnnual}</td>
            <td class="py-3 text-amber-500 font-semibold">- {formattedSocialAnnual}</td>
            <td class="py-3 text-right font-black text-emerald-600 dark:text-emerald-400">{formattedNetAnnual}</td>
          </tr>
          <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors">
            <td class="py-3 font-sans font-bold text-slate-800 dark:text-slate-200">Monthly Paycheck</td>
            <td class="py-3 text-slate-700 dark:text-slate-300">{curr} {Math.round(calcResult.grossMonthlySalary).toLocaleString()}</td>
            <td class="py-3 text-rose-500 font-semibold">- {curr} {Math.round(calcResult.incomeTaxMonthly).toLocaleString()}</td>
            <td class="py-3 text-amber-500 font-semibold">- {curr} {Math.round(calcResult.socialSecurityOrPensionMonthly).toLocaleString()}</td>
            <td class="py-3 text-right font-black text-emerald-600 dark:text-emerald-400">{formattedNetMonthly}</td>
          </tr>
          <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors">
            <td class="py-3 font-sans font-bold text-slate-800 dark:text-slate-200">Bi-Weekly (Every 2 Weeks)</td>
            <td class="py-3 text-slate-700 dark:text-slate-300">{curr} {Math.round(calcResult.grossBiWeeklySalary).toLocaleString()}</td>
            <td class="py-3 text-rose-500 font-semibold">- {curr} {Math.round(calcResult.incomeTaxAnnual / 26).toLocaleString()}</td>
            <td class="py-3 text-amber-500 font-semibold">- {curr} {Math.round(calcResult.socialSecurityOrPensionAnnual / 26).toLocaleString()}</td>
            <td class="py-3 text-right font-black text-emerald-600 dark:text-emerald-400">{curr} {Math.round(calcResult.netTakeHomeBiWeekly).toLocaleString()}</td>
          </tr>
          <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors">
            <td class="py-3 font-sans font-bold text-slate-800 dark:text-slate-200">Weekly Paycheck</td>
            <td class="py-3 text-slate-700 dark:text-slate-300">{curr} {Math.round(calcResult.grossWeeklySalary).toLocaleString()}</td>
            <td class="py-3 text-rose-500 font-semibold">- {curr} {Math.round(calcResult.incomeTaxAnnual / 52).toLocaleString()}</td>
            <td class="py-3 text-amber-500 font-semibold">- {curr} {Math.round(calcResult.socialSecurityOrPensionAnnual / 52).toLocaleString()}</td>
            <td class="py-3 text-right font-black text-emerald-600 dark:text-emerald-400">{curr} {Math.round(calcResult.netTakeHomeWeekly).toLocaleString()}</td>
          </tr>
          <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors">
            <td class="py-3 font-sans font-bold text-slate-800 dark:text-slate-200">Daily Rate (260 Days)</td>
            <td class="py-3 text-slate-700 dark:text-slate-300">{curr} {Math.round(calcResult.grossDailySalary).toLocaleString()}</td>
            <td class="py-3 text-rose-500 font-semibold">- {curr} {Math.round(calcResult.incomeTaxAnnual / 260).toLocaleString()}</td>
            <td class="py-3 text-amber-500 font-semibold">- {curr} {Math.round(calcResult.socialSecurityOrPensionAnnual / 260).toLocaleString()}</td>
            <td class="py-3 text-right font-black text-emerald-600 dark:text-emerald-400">{curr} {Math.round(calcResult.netTakeHomeDaily).toLocaleString()}</td>
          </tr>
          <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/50 transition-colors">
            <td class="py-3 font-sans font-bold text-slate-800 dark:text-slate-200">Hourly Equivalent (2080 Hrs)</td>
            <td class="py-3 text-slate-700 dark:text-slate-300">{curr} {calcResult.grossHourlySalary.toFixed(2)}</td>
            <td class="py-3 text-rose-500 font-semibold">- {curr} {(calcResult.incomeTaxAnnual / 2080).toFixed(2)}</td>
            <td class="py-3 text-amber-500 font-semibold">- {curr} {(calcResult.socialSecurityOrPensionAnnual / 2080).toFixed(2)}</td>
            <td class="py-3 text-right font-black text-emerald-600 dark:text-emerald-400">{curr} {calcResult.netTakeHomeHourly.toFixed(2)}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  {/* Adjacent Income Milestone Internal Linking Matrix */}
  <section class="max-w-7xl mx-auto px-4 py-8 border-t border-slate-200/80 dark:border-slate-800/80 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">
          Explore Adjacent Income Tiers in {countryData.countryName}
        </h2>
        <p class="text-xs text-slate-400">
          Compare take-home pay and tax brackets across neighboring compensation levels.
        </p>
      </div>
      <a
        href={`/salary-calculator/${countryData.countryCode.toLowerCase()}`}
        class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline"
      >
        View All {countryData.countryName} Tiers →
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {allMilestones.map((m) => (
        <a
          href={`/salary-calculator/${countryData.countryCode.toLowerCase()}/${m}-${countryData.currencyCode.toLowerCase()}`}
          class={`p-4 rounded-2xl border text-center transition-all flex flex-col justify-between ${
            m === salaryAmount
              ? 'bg-emerald-600 text-white border-emerald-600 shadow-md font-bold'
              : 'bg-white dark:bg-[#0F172A] border-slate-200/80 dark:border-slate-800/80 hover:border-emerald-500 text-slate-700 dark:text-slate-300 shadow-card-light dark:shadow-none'
          }`}
        >
          <span class="text-xs font-black font-mono" data-financial-figure>
            {curr} {m.toLocaleString()}
          </span>
          <span class="text-[10px] opacity-80 mt-1 font-semibold">
            {m === salaryAmount ? '● Active View' : 'Calculate →'}
          </span>
        </a>
      ))}
    </div>

    {/* Previous / Next Quick Jump */}
    <div class="flex items-center justify-between pt-4">
      {prevMilestone ? (
        <a
          href={`/salary-calculator/${countryData.countryCode.toLowerCase()}/${prevMilestone}`}
          class="inline-flex items-center space-x-2 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-emerald-600 transition"
        >
          <span>← Previous Tier ({curr} {prevAmount?.toLocaleString()})</span>
        </a>
      ) : <div />}

      {nextMilestone ? (
        <a
          href={`/salary-calculator/${countryData.countryCode.toLowerCase()}/${nextMilestone}`}
          class="inline-flex items-center space-x-2 text-xs font-bold text-slate-600 dark:text-slate-300 hover:text-emerald-600 transition"
        >
          <span>Next Tier ({curr} {nextAmount?.toLocaleString()}) →</span>
        </a>
      ) : <div />}
    </div>
  </section>

  {/* Statutory Contextual Analysis & FAQ Section */}
  <section class="max-w-4xl mx-auto px-4 py-14 border-t border-slate-200/80 dark:border-slate-800/80 space-y-8">
    <div class="text-center space-y-2">
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white">
        Tax Questions & Answers for {formattedGross} in {countryData.countryName}
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        Pre-computed calculations based on official statutory tax laws.
      </p>
    </div>

    <div class="space-y-4">
      {dynamicFaqs.map((faq) => (
        <details class="group bg-white dark:bg-[#0F172A] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 shadow-card-light dark:shadow-none transition-all">
          <summary class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-slate-100 cursor-pointer flex justify-between items-center list-none select-none">
            <span>{faq.question}</span>
            <span class="text-emerald-600 dark:text-emerald-400 group-open:rotate-180 transition-transform text-lg ml-4 flex-shrink-0">↓</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mt-4 pt-4 border-t border-slate-100 dark:border-slate-800/80">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</Layout>
