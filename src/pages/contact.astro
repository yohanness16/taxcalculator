---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Support | TOOLBOXS"
  description="Get in touch with the TOOLBOXS team for inquiries, statutory tax updates, and partner integrations."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Contact Us', url: '/contact' },
  ]}
>
  <div class="max-w-2xl mx-auto px-4 py-12 md:py-16 space-y-8">
    <div class="text-center space-y-3">
      <div class="inline-flex items-center space-x-2 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/80 dark:border-emerald-800/80 px-4 py-1.5 rounded-full text-xs font-extrabold text-emerald-700 dark:text-emerald-300 shadow-xs">
        <span>📬 Support & Feedback</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Contact & Support
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-lg mx-auto leading-relaxed">
        Have feedback, questions, or updated tax statutory legislation to submit? Reach out to our engineering team.
      </p>
    </div>

    <div class="bg-white dark:bg-[#0F172A] p-7 sm:p-8 rounded-3xl border border-slate-200/80 dark:border-slate-800/80 shadow-card-light dark:shadow-none space-y-5">
      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Your Full Name</label>
        <input
          type="text"
          placeholder="e.g. Alex Smith"
          class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-slate-900 dark:text-white transition"
        />
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Email Address</label>
        <input
          type="email"
          placeholder="alex@example.com"
          class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-slate-900 dark:text-white transition"
        />
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Inquiry Subject</label>
        <select class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-slate-900 dark:text-white transition cursor-pointer">
          <option>Statutory Tax Law Correction / Update</option>
          <option>Advertising & Partnership Inquiries</option>
          <option>Feature Request / Feedback</option>
          <option>General Support</option>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Message</label>
        <textarea
          rows={4}
          placeholder="Provide details regarding your request..."
          class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-slate-900 dark:text-white transition"
        ></textarea>
      </div>

      <button
        type="button"
        onclick="alert('Thank you! Your message has been sent successfully.');"
        class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white font-extrabold text-xs sm:text-sm rounded-2xl transition shadow-md shadow-emerald-600/20"
      >
        Send Message →
      </button>
    </div>
  </div>
</Layout>
