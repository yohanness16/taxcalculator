---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Support | GlobalTaxCalc"
  description="Get in touch with the GlobalTaxCalc team for inquiries, statutory tax updates, and partner integrations."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Contact Us', url: '/contact' },
  ]}
>
  <div class="max-w-2xl mx-auto px-4 py-12 space-y-6">
    <div class="text-center space-y-2">
      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white">
        Contact & Support
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        Have feedback, questions, or updated tax statutory legislation to submit? Reach out to our engineering team.
      </p>
    </div>

    <div class="bg-white dark:bg-[#151D2A] p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-5">
      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Your Full Name</label>
        <input
          type="text"
          placeholder="e.g. Alex Smith"
          class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Email Address</label>
        <input
          type="email"
          placeholder="alex@example.com"
          class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Inquiry Subject</label>
        <select class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
          <option>Statutory Tax Law Correction / Update</option>
          <option>Advertising & Partnership Inquiries</option>
          <option>Feature Request / Feedback</option>
          <option>General Support</option>
        </select>
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Message</label>
        <textarea
          rows={4}
          placeholder="Provide details regarding your request..."
          class="w-full p-2.5 bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-xs sm:text-sm outline-none focus:ring-2 focus:ring-emerald-500"
        ></textarea>
      </div>

      <button
        type="button"
        onclick="alert('Thank you! Your message has been sent successfully.');"
        class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-md"
      >
        Send Message →
      </button>
    </div>
  </div>
</Layout>
