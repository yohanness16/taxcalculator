---
import Layout from '../../layouts/Layout.astro';
import { GLOBAL_COUNTRIES_DATA } from '../../data/globalTaxData';

const countries = [...GLOBAL_COUNTRIES_DATA].sort((a, b) =>
  a.countryName.localeCompare(b.countryName)
);

const pageTitle = "Global Salary & Income Tax Calculator 2026 Directory (A–Z) | TOOLBOXS";
const pageDescription = "Calculate net take-home salary, income taxes, and statutory deductions across 100+ global jurisdictions. Pre-computed tax tables and paycheck converters.";

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Salary Directory', url: 'https://toolboxs.tech/salary' },
];

const faqs = [
  {
    question: "How is global salary and take-home pay calculated on TOOLBOXS?",
    answer: "TOOLBOXS computes exact statutory take-home pay by evaluating progressive marginal tax brackets, mandatory social security contributions, national pension schemes (such as POESSA in Ethiopia, FICA in the US, and HMRC PAYE in the UK), and standard deductions.",
  },
  {
    question: "How is employment income tax calculated in Ethiopia?",
    answer: "Under the updated Income Tax (Amendment) Proclamation No. 1395/2025, employment income is progressive from 0% on the first 2,000 ETB up to 35% on income over 14,000 ETB, with a mandatory 7% POESSA employee pension deduction from gross basic salary.",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://toolboxs.tech/salary"
  faqs={faqs}
  breadcrumbs={breadcrumbs}
>
  <section class="py-12 px-4 max-w-7xl mx-auto text-center space-y-3">
    <div class="inline-flex items-center space-x-2 px-3 py-1 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/60 dark:border-emerald-800/60 rounded-full text-xs font-extrabold text-emerald-700 dark:text-emerald-300">
      <span>🌍 100+ Global Jurisdictions</span>
      <span>•</span>
      <span>2026 Statutory Matrices</span>
    </div>

    <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-900 dark:text-white">
      Global Salary & Tax <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-teal-500">Calculator Directory</span>
    </h1>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
      Select any country below to compute net take-home salary, income taxes, and pension deductions with pre-computed statutory paycheck tables.
    </p>
  </section>

  <section class="max-w-7xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {countries.map((c) => (
        <a
          href={`/salary/${c.countryCode.toLowerCase()}`}
          class="group p-5 bg-white dark:bg-[#0F1626] border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm hover:shadow-md hover:border-emerald-500 transition space-y-2 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2">
                <span class="text-2xl">{c.flagEmoji}</span>
                <span class="font-extrabold text-base text-slate-900 dark:text-white group-hover:text-emerald-500 transition-colors">
                  {c.countryName}
                </span>
              </div>
              <span class="text-xs font-bold px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 rounded-lg">
                {c.currencyCode}
              </span>
            </div>

            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2 mt-2 leading-relaxed">
              {c.summaryDescription}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-semibold">{c.taxSystem}</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">Calculate Paycheck →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
