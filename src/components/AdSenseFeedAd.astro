---
export interface Props {
  slotId?: string;
  layoutKey?: string;
  className?: string;
}

const {
  slotId = '1208717370',
  layoutKey = '-eb+6l-2v-aq+u1',
  className = '',
} = Astro.props;
---

<div class={`adsense-feed-ad w-full my-6 bg-white dark:bg-[#0F172A] border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-4 shadow-card-light dark:shadow-none overflow-hidden ${className}`}>
  <div class="flex items-center justify-between text-[10px] font-mono font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest pb-2 mb-2 border-b border-slate-100 dark:border-slate-800/60">
    <span>Sponsored Feed Content</span>
    <span>Advertisement</span>
  </div>
  <div class="w-full">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-format="fluid"
      data-ad-layout-key={layoutKey}
      data-ad-client="ca-pub-6768212179657827"
      data-ad-slot={slotId}
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
</div>
