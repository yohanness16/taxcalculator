---
import { GLOBAL_COUNTRIES_DATA } from '../data/globalTaxData';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 dark:border-slate-800 bg-white/90 dark:bg-[#151D2A]/90 backdrop-blur-md transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    
    {/* Brand Logo */}
    <a href="/" class="flex items-center space-x-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white font-black text-lg shadow-md shadow-emerald-500/20 group-hover:scale-105 transition-transform">
        %
      </div>
      <div class="flex flex-col">
        <span class="font-black text-lg tracking-tight text-slate-900 dark:text-white leading-none">
          GlobalTax<span class="text-emerald-500">Calc</span>
        </span>
        <span class="text-[10px] text-slate-400 font-semibold tracking-wider uppercase mt-0.5">
          Salary & Tax Intelligence
        </span>
      </div>
    </a>

    {/* Center Navigation Links */}
    <nav class="hidden md:flex items-center space-x-1 text-xs font-bold text-slate-600 dark:text-slate-300">
      <a
        href="/"
        class={`px-3 py-2 rounded-lg transition ${
          currentPath === '/' ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60' : 'hover:bg-slate-100 dark:hover:bg-slate-800'
        }`}
      >
        Global Salary
      </a>
      
      <a
        href="/salary-calculator"
        class={`px-3 py-2 rounded-lg transition ${
          currentPath === '/salary-calculator' ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60' : 'hover:bg-slate-100 dark:hover:bg-slate-800'
        }`}
      >
        All Countries
      </a>

      <a
        href="/1099-tax-calculator"
        class={`px-3 py-2 rounded-lg transition ${
          currentPath.includes('/1099') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60' : 'hover:bg-slate-100 dark:hover:bg-slate-800'
        }`}
      >
        1099 Freelance
      </a>

      <a
        href="/mortgage-calculator"
        class={`px-3 py-2 rounded-lg transition ${
          currentPath.includes('/mortgage') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60' : 'hover:bg-slate-100 dark:hover:bg-slate-800'
        }`}
      >
        Mortgage
      </a>

      <a
        href="/fire-calculator"
        class={`px-3 py-2 rounded-lg transition ${
          currentPath.includes('/fire') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60' : 'hover:bg-slate-100 dark:hover:bg-slate-800'
        }`}
      >
        FIRE & Growth
      </a>

      <a
        href="/tax-brackets"
        class={`px-3 py-2 rounded-lg transition ${
          currentPath.includes('/tax-brackets') ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60' : 'hover:bg-slate-100 dark:hover:bg-slate-800'
        }`}
      >
        Tax Laws
      </a>
    </nav>

    {/* Right: Country Jump Selector & Theme Toggle */}
    <div class="flex items-center space-x-2.5">
      <div class="hidden sm:block">
        <select
          id="header-country-select"
          class="bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 rounded-xl px-2.5 py-1.5 text-xs font-bold outline-none cursor-pointer focus:ring-2 focus:ring-emerald-500"
          onchange="window.location.href='/salary-calculator/' + this.value.toLowerCase()"
        >
          <option value="">🌍 Switch Country...</option>
          {GLOBAL_COUNTRIES_DATA.map((c) => (
            <option value={c.countryCode}>
              {c.flagEmoji} {c.countryName} ({c.currencyCode})
            </option>
          ))}
        </select>
      </div>

      <button
        id="theme-toggle-btn"
        class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition"
        aria-label="Toggle Dark Mode"
      >
        <span class="dark:hidden">🌙</span>
        <span class="hidden dark:inline">☀️</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // Theme Toggle Script
  const themeBtn = document.getElementById('theme-toggle-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }
</script>
