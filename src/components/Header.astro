---
import { GLOBAL_COUNTRIES_DATA } from '../data/globalTaxData';

const currentPath = Astro.url.pathname;

// Sort countries alphabetically for header selector
const sortedCountries = [...GLOBAL_COUNTRIES_DATA].sort((a, b) =>
  a.countryName.localeCompare(b.countryName)
);
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/95 dark:bg-[#090D16]/95 backdrop-blur-xl transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    
    {/* Brand Logo */}
    <a href="/" class="flex items-center space-x-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-xl">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white font-black text-base shadow-sm shadow-emerald-500/25 group-hover:scale-[1.03] transition-all">
        TB
      </div>
      <div class="flex flex-col">
        <div class="flex items-center space-x-1.5">
          <span class="font-extrabold text-lg tracking-tight text-slate-900 dark:text-white leading-tight">
            TOOLBOXS<span class="text-emerald-500 font-black">.TECH</span>
          </span>
        </div>
        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold tracking-wider uppercase">
          Global Tax & Payroll Engine
        </span>
      </div>
    </a>

    {/* Center Navigation Links */}
    <nav class="hidden lg:flex items-center space-x-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
      <a
        href="/"
        class={`px-3 py-1.5 rounded-lg transition-all ${
          currentPath === '/'
            ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/60 dark:border-emerald-800/60 font-bold shadow-xs'
            : 'hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
        }`}
      >
        Global Salary
      </a>
      <a
        href="/salary-calculator"
        class={`px-3 py-1.5 rounded-lg transition-all ${
          currentPath.startsWith('/salary-calculator') && currentPath !== '/'
            ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/60 dark:border-emerald-800/60 font-bold shadow-xs'
            : 'hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
        }`}
      >
        All Countries (A–Z)
      </a>
      <a
        href="/1099-tax-calculator"
        class={`px-3 py-1.5 rounded-lg transition-all ${
          currentPath.includes('/1099-tax')
            ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/60 dark:border-emerald-800/60 font-bold shadow-xs'
            : 'hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
        }`}
      >
        1099 Freelance
      </a>
      <a
        href="/mortgage-calculator"
        class={`px-3 py-1.5 rounded-lg transition-all ${
          currentPath.includes('/mortgage')
            ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/60 dark:border-emerald-800/60 font-bold shadow-xs'
            : 'hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
        }`}
      >
        Mortgage PITI
      </a>
      <a
        href="/fire-calculator"
        class={`px-3 py-1.5 rounded-lg transition-all ${
          currentPath.includes('/fire')
            ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/60 dark:border-emerald-800/60 font-bold shadow-xs'
            : 'hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
        }`}
      >
        FIRE Compound
      </a>
      <a
        href="/tax-brackets"
        class={`px-3 py-1.5 rounded-lg transition-all ${
          currentPath.includes('/tax-brackets')
            ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200/60 dark:border-emerald-800/60 font-bold shadow-xs'
            : 'hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800/60'
        }`}
      >
        Tax Laws
      </a>
    </nav>

    {/* Right: Country Jump Selector & Theme Toggle */}
    <div class="flex items-center space-x-2.5">
      <div class="hidden sm:block">
        <select
          id="header-country-select"
          class="bg-slate-50 dark:bg-slate-800/90 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 rounded-xl px-3 py-1.5 text-xs font-semibold outline-none cursor-pointer focus:ring-2 focus:ring-emerald-500 hover:border-slate-400 transition"
          onchange="if(this.value) window.location.href='/salary-calculator/' + this.value.toLowerCase()"
          aria-label="Select Country Calculator"
        >
          <option value="">🌍 Switch Country (A–Z)...</option>
          {sortedCountries.map((c) => (
            <option value={c.countryCode}>
              {c.flagEmoji} {c.countryName} ({c.currencyCode})
            </option>
          ))}
        </select>
      </div>

      <button
        id="theme-toggle-btn"
        class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800/90 hover:bg-slate-200 dark:hover:bg-slate-700/90 text-slate-600 dark:text-slate-300 border border-slate-200/70 dark:border-slate-700/70 transition-all hover:scale-105 active:scale-95"
        aria-label="Toggle Dark Mode"
      >
        <span class="dark:hidden text-sm">🌙</span>
        <span class="hidden dark:inline text-sm">☀️</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // Theme Toggle Script
  const themeBtn = document.getElementById('theme-toggle-btn');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }
</script>
